{{ 'ekko-footer.css' | asset_url | stylesheet_tag }}

<footer class="section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-main-box ekko-footer-wrapper" role="contentinfo">

  <div class="footer-top">

    <div class="footer-social">
      <h3>{{ section.settings.social_heading }}</h3>
      <div class="footer-social-icons">
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.twitter_url != blank -%}
          <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.17 8.17 0 0 0 4.78 1.52V6.75a4.86 4.86 0 0 1-1.01-.06z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="footer-newsletter">
      <p>{{ section.settings.newsletter_text }}</p>
      {%- assign newsletter_form_id = 'ekko-footer-newsletter-' | append: section.id -%}
      {%- form 'customer', id: newsletter_form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer-email-form">
          <div class="footer-email-field">
            <input
              type="email"
              name="contact[email]"
              id="ekko-newsletter-email-{{ section.id }}"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              aria-label="{{ section.settings.email_placeholder | escape }}"
              required
            >
          </div>
          <button type="submit" class="footer-email-btn">
            {{ section.settings.submit_label | escape }}
          </button>
        </div>
      {%- endform -%}
    </div>

  </div>

  {% if section.blocks.size > 0 %}
    <nav class="footer-nav" aria-label="Footer navigation">
      {% for block in section.blocks %}
        <div class="footer-nav-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h4>{{ block.settings.heading }}</h4>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            {%- assign nav_menu = linklists[block.settings.menu] -%}
            {%- if nav_menu.links.size > 0 -%}
              <ul>
                {% for link in nav_menu.links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="footer-bottom">
    <div class="footer-bottom-links">
      {%- if shop.privacy_policy != blank -%}
        <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
      {%- endif -%}
      {%- if shop.refund_policy != blank -%}
        <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>
      {%- endif -%}
      {%- if shop.terms_of_service != blank -%}
        <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>
      {%- endif -%}
      {%- if section.settings.accessibility_link != blank -%}
        <a href="{{ section.settings.accessibility_link }}">Accessibility</a>
      {%- endif -%}
    </div>
    <p class="footer-copyright">{{ section.settings.copyright_text }}</p>
  </div>

</footer>

{% schema %}
{
  "name": "Ekko Footer",
  "class": "ekko-footer-section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Sign up to receive email news, promotions, and information about Ekko."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "url",
      "id": "accessibility_link",
      "label": "Accessibility page link"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "©EkkoBath All Rights Reserved"
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Navigation Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Column Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ekko Footer",
      "blocks": [
        {
          "type": "nav_column",
          "settings": {
            "heading": "Company & Resources"
          }
        },
        {
          "type": "nav_column",
          "settings": {
            "heading": "Customer Service"
          }
        },
        {
          "type": "nav_column",
          "settings": {
            "heading": "Shop by Category"
          }
        }
      ]
    }
  ]
}
{% endschema %}
