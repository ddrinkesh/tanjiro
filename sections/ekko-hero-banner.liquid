{{ 'ekko-hero-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture slider_options -%}
  "slidesPerView": 1,
  "loop": true,
  "effect": "fade",
  "speed": 800,
  "autoplay": {
    "delay": 4000,
    "disableOnInteraction": false
  }
  {% if section.settings.show_navigation %}
  ,"navigation": {
    "nextEl": "#shopify-section-{{ section.id }} .swiper-button-next",
    "prevEl": "#shopify-section-{{ section.id }} .swiper-button-prev"
  }
  {% endif %}
  {% if section.settings.show_pagination %}
  ,"pagination": {
    "el": "#shopify-section-{{ section.id }} .swiper-pagination",
    "clickable": true
  }
  {% endif %}
{%- endcapture -%}

<div class="ekko-hero-banner-wrapper section-main-box">

  <div class="swiper" data-slider-options='{ {{ slider_options }} }'>
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {%- if forloop.index == 1 -%}
          {%- assign img_loading = 'eager' -%}
          {%- assign img_fetchpriority = 'high' -%}
        {%- else -%}
          {%- assign img_loading = 'lazy' -%}
          {%- assign img_fetchpriority = 'auto' -%}
        {%- endif -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1920
              | image_tag:
                loading: img_loading,
                fetchpriority: img_fetchpriority,
                widths: '750, 1100, 1500, 1920',
                sizes: '100vw',
                width: block.settings.image.width,
                height: block.settings.image.height,
                class: 'slide-bg'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'slide-bg placeholder-svg' }}
          {%- endif -%}
          <div class="slide-overlay"></div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_navigation %}
      <div class="swiper-button-prev" aria-label="Previous slide"></div>
      <div class="swiper-button-next" aria-label="Next slide"></div>
    {% endif %}

    {% if section.settings.show_pagination %}
      <div class="swiper-pagination" aria-hidden="true"></div>
    {% endif %}
  </div>

  {% if section.settings.heading != blank or section.settings.subtext != blank or section.settings.button_label != blank %}
    <div class="hero-content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="hero-subtext">{{ section.settings.subtext }}</p>
      {% endif %}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="hero-btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Ekko Hero Banner",
  "class": "ekko-hero-banner-section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Everyday Living with Timeless Design"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover premium bathroom and kitchen solutions crafted for performance, style, and durability."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image-with-text.blocks.button.settings.button_label.label",
      "info": "t:sections.image-with-text.blocks.button.settings.button_label.info",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image-with-text.blocks.button.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "Slider Options"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ekko Hero Banner",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
